---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Community Partners | NTX Mesh"
  description="Learn about NTX Mesh community partners and how to get involved."
>
  <section class="page-hero border-b border-mesh-border bg-mesh-surface">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <h1>Community Partners</h1>
      <p class="mt-4">
        NTX Mesh is a community-driven project. We actively seek partnerships with organizations that share our values of open communication, disaster resilience, and community infrastructure.
      </p>
    </div>
  </section>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-16">

    <!-- What we're looking for -->
    <section class="mb-16">
      <h2 class="section-heading mb-6">Partnership Opportunities</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        <div class="card text-center">
          <div class="w-12 h-12 rounded-xl bg-mesh-green/10 flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6 text-mesh-green" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.14 0M1.394 9.393c5.857-5.857 15.355-5.857 21.213 0"/>
            </svg>
          </div>
          <h3 class="font-mono font-bold text-mesh-text mb-2">Ham Radio Clubs</h3>
          <p class="text-mesh-muted text-sm">Ham operators bring deep radio knowledge and often have access to towers and rooftops for repeater placement.</p>
        </div>

        <div class="card text-center">
          <div class="w-12 h-12 rounded-xl bg-mesh-green/10 flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6 text-mesh-green" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
            </svg>
          </div>
          <h3 class="font-mono font-bold text-mesh-text mb-2">Educational Institutions</h3>
          <p class="text-mesh-muted text-sm">Schools, universities, and maker spaces that want to teach wireless networking, emergency comms, and open-source tech.</p>
        </div>

        <div class="card text-center">
          <div class="w-12 h-12 rounded-xl bg-mesh-green/10 flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6 text-mesh-green" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
            </svg>
          </div>
          <h3 class="font-mono font-bold text-mesh-text mb-2">Municipal &amp; Non-Profits</h3>
          <p class="text-mesh-muted text-sm">Disaster relief agencies, Red Cross chapters, and mutual aid groups benefit from — and help grow — the mesh network.</p>
        </div>
      </div>
    </section>

    <!-- Current partners placeholder -->
    <section class="mb-16">
      <h2 class="section-heading mb-6">Current Partners</h2>
      <div class="card p-12 text-center border-dashed">
        <p class="text-mesh-muted mb-2">Partner logos will appear here.</p>
        <p class="text-mesh-muted text-sm">Interested in becoming our first listed partner? Reach out below.</p>
      </div>
    </section>

    <!-- Contact CTA -->
    <section class="card p-10 text-center border-mesh-green/30 bg-mesh-green/5">
      <h2 class="font-mono text-2xl font-bold text-mesh-text mb-3">Become a Partner</h2>
      <p class="text-mesh-muted mb-2">
        We'd love to connect with ham clubs, educational institutions, maker spaces, disaster relief organizations, and any community group that wants to help build resilient communications infrastructure in North Texas.
      </p>
      <p class="text-mesh-muted mb-8">
        Partners can host repeater nodes, help coordinate events, provide technical expertise, or simply spread the word.
      </p>
      <a href="mailto:ntxmesh@gmail.com" class="btn-primary text-base px-8 py-3">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
        </svg>
        ntxmesh@gmail.com
      </a>
    </section>
  </div>
</Layout>
