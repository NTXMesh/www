---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Coverage Map & Modem Presets by County | NTX Mesh"
  description="View the NTX Mesh modem preset map by county and the RF coverage heatmap for the North Texas network."
>
  <section class="page-hero border-b border-mesh-border bg-mesh-surface">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <h1>Coverage &amp; Modem Presets</h1>
      <p class="mt-4">
        Before you configure your device, check which modem preset your county uses. Some areas operate on different presets than the default Long_Fast due to local mesh conditions.
      </p>
    </div>
  </section>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-16">

    <!-- Preset map -->
    <section id="presets">
      <h2 class="section-heading">Modem Preset Map by County</h2>
      <p class="text-mesh-muted mb-6">
        Click the map to open the full-size image.
      </p>
      <div class="rounded-xl overflow-hidden border border-mesh-border bg-mesh-surface p-2">
        <a href="/images/Modem_Presets_by_County_Map.png" target="_blank" rel="noopener" title="Open full-size preset map">
          <img
            src="/images/Modem_Presets_by_County_Map.png"
            alt="Modem Preset Map by County for NTX Mesh"
            class="w-full h-auto rounded-lg"
            loading="lazy"
          />
        </a>
      </div>
      <p class="text-mesh-muted text-sm mt-3">Click the map to view full resolution.</p>
    </section>

    <!-- Coverage heatmap -->
    <section id="coverage-map" class="mt-16 pt-8 border-t border-mesh-border">
      <h2 class="section-heading">RF Coverage Heatmap</h2>
      <p class="text-mesh-muted mb-2">
        This map shows range test data from the NTX Mesh network. Brighter areas indicate better coverage.
      </p>
      <div class="bg-mesh-surface-2 border border-mesh-border rounded-lg p-3 text-sm text-mesh-muted mb-6">
        <strong class="text-mesh-text">Note:</strong> This is range test data, not live node data. For live node positions, see the
        <a href="https://meshmap.net/" target="_blank" rel="noopener" class="text-mesh-green hover:underline">MeshMap</a> — though keep in mind that map relies on MQTT, which <a href="/join/#best-practices" class="text-mesh-green hover:underline">we don't recommend using</a>.
      </div>
      <div id="map" class="rounded-xl overflow-hidden border border-mesh-border" style="height: 500px; width: 100%;"></div>
    </section>

    <!-- Community node map -->
    <section id="node-map" class="mt-16 pt-8 border-t border-mesh-border">
      <h2 class="section-heading">Community Node Map</h2>
      <p class="text-mesh-muted mb-6">
        This is the collaborative map where community members mark their stationary nodes. Use it to plan future node placements and coordinate with others in your area.
      </p>
      <div class="rounded-xl overflow-hidden border border-mesh-border">
        <iframe
          style="height:500px; width:100%; border:none;"
          src="https://facilmap.org/bXo7w1Lyve2G#9/32.8909/-97.0258/Lima"
          title="NTX Mesh Community Node Map"
          loading="lazy"
        ></iframe>
      </div>
      <p class="text-sm text-mesh-muted mt-2">
        Map on <a href="https://facilmap.org/bXo7w1Lyve2G" target="_blank" rel="noopener" class="text-mesh-green hover:underline">FacilMap</a>.
        Add your own stationary node to help the community plan expansion.
      </p>
    </section>

    <!-- Quick links -->
    <div class="mt-12 grid grid-cols-1 sm:grid-cols-3 gap-4">
      <a href="/learn/#coverage" class="card hover:border-mesh-green/40 text-center p-4">
        <p class="font-mono font-bold text-mesh-text mb-1">Learn More</p>
        <p class="text-mesh-muted text-sm">About coverage and how the mesh works</p>
      </a>
      <a href="/mc-repeaters/" class="card hover:border-mesh-green/40 text-center p-4">
        <p class="font-mono font-bold text-mesh-text mb-1">MeshCore Repeaters</p>
        <p class="text-mesh-muted text-sm">Repeater ID registry for DFW</p>
      </a>
      <a href="/devices/#solar" class="card hover:border-mesh-green/40 text-center p-4">
        <p class="font-mono font-bold text-mesh-text mb-1">Add Coverage</p>
        <p class="text-mesh-muted text-sm">Build a solar repeater</p>
      </a>
    </div>
  </div>
</Layout>

<!-- Leaflet -->
<link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet/dist/leaflet.js" is:inline></script>
<script src="https://unpkg.com/leaflet.heat/dist/leaflet-heat.js" is:inline></script>
<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    var map = L.map('map').setView([32.8909, -97.0258], 9);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '© OpenStreetMap contributors',
    }).addTo(map);

    fetch('/data/NTX-mesh-rangetests.csv')
      .then(function(r) { return r.text(); })
      .then(function(csv) {
        var heatData = [];
        csv.split('\n').forEach(function(line, i) {
          if (i === 0) return;
          var cols = line.split(',');
          if (cols.length >= 3) {
            var lat = parseFloat(cols[0]);
            var lng = parseFloat(cols[1]);
            var intensity = parseFloat(cols[2]);
            if (!isNaN(lat) && !isNaN(lng)) {
              heatData.push([lat, lng, intensity]);
            }
          }
        });
        L.heatLayer(heatData, { radius: 25, blur: 30, max: 200, maxZoom: 13, minOpacity: 0.3 }).addTo(map);
      })
      .catch(function() { /* no CSV yet, that's fine */ });
  });
</script>
