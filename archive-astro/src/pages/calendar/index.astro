---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Community Calendar | NTX Mesh"
  description="View upcoming NTX Mesh meetups, events, and community gatherings in the DFW area."
>
  <section class="page-hero border-b border-mesh-border bg-mesh-surface">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <h1>Community Calendar</h1>
      <p class="mt-4">
        Upcoming meetups, events, and community gatherings for NTX Mesh. We try to meet at least once per quarter — sometimes 30+ people show up, sometimes it's just a few of us at the pub. All are welcome.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center mt-8">
        <a href="https://discord.gg/nGeQ8cbSM3" target="_blank" rel="noopener" class="btn-primary">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03z"/>
          </svg>
          Follow events on Discord
        </a>
      </div>
    </div>
  </section>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-16">
    <h2 class="section-heading mb-6">Upcoming Events</h2>
    <div class="rounded-xl overflow-hidden border border-mesh-border bg-mesh-surface">
      <iframe
        src="https://calendar.google.com/calendar/embed?src=ntxmesh%40gmail.com&ctz=America%2FChicago&showTitle=0&showNav=1&showDate=1&showPrint=0&showTabs=0&showCalendars=0&showTz=1&mode=AGENDA"
        style="border:0"
        width="100%"
        height="600"
        frameborder="0"
        scrolling="no"
        title="NTX Mesh Community Calendar"
      ></iframe>
    </div>
    <p class="text-mesh-muted text-sm mt-3">
      All times shown in <strong class="text-mesh-text">Central Time (America/Chicago)</strong>.
      Can't see the calendar? <a href="https://discord.gg/nGeQ8cbSM3" target="_blank" rel="noopener" class="text-mesh-green hover:underline">Check Discord</a> for the latest event announcements.
    </p>
  </div>
</Layout>
