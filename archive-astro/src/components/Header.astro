---
const currentPath = Astro.url.pathname;

function isActive(path: string) {
  if (path === '/') return currentPath === '/';
  return currentPath.startsWith(path);
}
---

<header class="sticky top-0 z-50 bg-mesh-bg/90 backdrop-blur-md border-b border-mesh-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="flex items-center justify-between h-16">

      <!-- Logo -->
      <a href="/" class="flex-shrink-0">
        <img
          src="/images/NTX-Mesh-Logo.svg"
          alt="NTX Mesh"
          class="h-8 w-auto"
          width="200"
          height="49"
        />
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden lg:flex items-center gap-1" aria-label="Main navigation">

        <a href="/" class={`nav-link ${isActive('/') ? 'nav-link-active' : ''}`}>Home</a>

        <!-- Learn dropdown -->
        <div class="relative group">
          <button class={`nav-link flex items-center gap-1 ${isActive('/learn') || isActive('/coverage-map') || isActive('/mc-repeaters') ? 'nav-link-active' : ''}`}>
            Learn
            <svg class="w-4 h-4 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div class="dropdown">
            <a href="/learn/#about" class="dropdown-item">About NTX Mesh</a>
            <a href="/learn/#coverage" class="dropdown-item">Network Coverage</a>
            <a href="/coverage-map/" class="dropdown-item">Modem Presets by County</a>
            <a href="/mc-repeaters/" class="dropdown-item">MeshCore Repeaters</a>
            <a href="/learn/#comparisons" class="dropdown-item">Compare to APRS</a>
          </div>
        </div>

        <!-- Join dropdown -->
        <div class="relative group">
          <button class={`nav-link flex items-center gap-1 ${isActive('/join') ? 'nav-link-active' : ''}`}>
            Join
            <svg class="w-4 h-4 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div class="dropdown">
            <a href="/join/#network" class="dropdown-item">Connect to the Network</a>
            <a href="/join/#best-practices" class="dropdown-item">Best Practices</a>
            <a href="/join/#group" class="dropdown-item">Join the Community</a>
          </div>
        </div>

        <!-- Devices dropdown -->
        <div class="relative group">
          <button class={`nav-link flex items-center gap-1 ${isActive('/devices') ? 'nav-link-active' : ''}`}>
            Devices
            <svg class="w-4 h-4 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div class="dropdown">
            <a href="/devices/#pocket-portable" class="dropdown-item">Pocket / Portable Nodes</a>
            <a href="/devices/#stationary-solar" class="dropdown-item">Stationary / Solar Nodes</a>
            <a href="/devices/#solar" class="dropdown-item">Build a Solar Repeater</a>
          </div>
        </div>

        <!-- Community dropdown -->
        <div class="relative group">
          <button class={`nav-link flex items-center gap-1 ${isActive('/calendar') || isActive('/similar-networks') || isActive('/partners') ? 'nav-link-active' : ''}`}>
            Community
            <svg class="w-4 h-4 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div class="dropdown">
            <a href="/calendar/" class="dropdown-item">Calendar</a>
            <a href="https://discord.gg/nGeQ8cbSM3" target="_blank" rel="noopener" class="dropdown-item">Discord ↗</a>
            <a href="/similar-networks/" class="dropdown-item">Similar Networks</a>
            <a href="/partners/" class="dropdown-item">Partners</a>
          </div>
        </div>

        <a href="/join/" class="btn-primary text-sm py-2 px-4 ml-2">Get Started</a>
      </nav>

      <!-- Mobile hamburger -->
      <button
        id="mobile-menu-btn"
        class="lg:hidden p-2 text-mesh-muted hover:text-mesh-green transition-colors"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <svg id="hamburger-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="lg:hidden hidden border-t border-mesh-border bg-mesh-bg">
    <nav class="max-w-7xl mx-auto px-4 py-4 space-y-1">
      <a href="/" class="mobile-nav-link">Home</a>

      <div class="mobile-group">
        <button class="mobile-group-btn" data-target="mobile-learn">
          <span>Learn</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div id="mobile-learn" class="mobile-submenu hidden">
          <a href="/learn/#about" class="mobile-sub-link">About NTX Mesh</a>
          <a href="/learn/#coverage" class="mobile-sub-link">Network Coverage</a>
          <a href="/coverage-map/" class="mobile-sub-link">Modem Presets by County</a>
          <a href="/mc-repeaters/" class="mobile-sub-link">MeshCore Repeaters</a>
          <a href="/learn/#comparisons" class="mobile-sub-link">Compare to APRS</a>
        </div>
      </div>

      <div class="mobile-group">
        <button class="mobile-group-btn" data-target="mobile-join">
          <span>Join</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div id="mobile-join" class="mobile-submenu hidden">
          <a href="/join/#network" class="mobile-sub-link">Connect to the Network</a>
          <a href="/join/#best-practices" class="mobile-sub-link">Best Practices</a>
          <a href="/join/#group" class="mobile-sub-link">Join the Community</a>
        </div>
      </div>

      <div class="mobile-group">
        <button class="mobile-group-btn" data-target="mobile-devices">
          <span>Devices</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div id="mobile-devices" class="mobile-submenu hidden">
          <a href="/devices/#pocket-portable" class="mobile-sub-link">Pocket / Portable</a>
          <a href="/devices/#stationary-solar" class="mobile-sub-link">Stationary / Solar</a>
          <a href="/devices/#solar" class="mobile-sub-link">Build a Solar Repeater</a>
        </div>
      </div>

      <div class="mobile-group">
        <button class="mobile-group-btn" data-target="mobile-community">
          <span>Community</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div id="mobile-community" class="mobile-submenu hidden">
          <a href="/calendar/" class="mobile-sub-link">Calendar</a>
          <a href="https://discord.gg/nGeQ8cbSM3" target="_blank" rel="noopener" class="mobile-sub-link">Discord ↗</a>
          <a href="/similar-networks/" class="mobile-sub-link">Similar Networks</a>
          <a href="/partners/" class="mobile-sub-link">Partners</a>
        </div>
      </div>

      <div class="pt-2">
        <a href="/join/" class="btn-primary w-full justify-center">Get Started</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .nav-link {
    @apply px-3 py-2 text-sm text-mesh-muted hover:text-mesh-text rounded-md transition-colors font-medium;
  }
  .nav-link-active {
    @apply text-mesh-green;
  }
  .dropdown {
    @apply absolute top-full left-0 mt-1 w-56 bg-mesh-surface border border-mesh-border rounded-xl shadow-xl
           opacity-0 invisible translate-y-1
           group-hover:opacity-100 group-hover:visible group-hover:translate-y-0
           transition-all duration-200 z-50 py-1;
  }
  .dropdown-item {
    @apply block px-4 py-2.5 text-sm text-mesh-muted hover:text-mesh-text hover:bg-mesh-surface-2 transition-colors;
  }
  .mobile-nav-link {
    @apply block px-3 py-2 text-mesh-muted hover:text-mesh-text hover:bg-mesh-surface-2 rounded-lg transition-colors;
  }
  .mobile-group-btn {
    @apply flex items-center justify-between w-full px-3 py-2 text-mesh-muted hover:text-mesh-text hover:bg-mesh-surface-2 rounded-lg transition-colors;
  }
  .mobile-submenu {
    @apply pl-4 mt-1 space-y-1 border-l border-mesh-border ml-3;
  }
  .mobile-sub-link {
    @apply block px-3 py-2 text-sm text-mesh-muted hover:text-mesh-green transition-colors;
  }
</style>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const hamburger = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  btn?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden', isOpen);
    hamburger?.classList.toggle('hidden', !isOpen);
    closeIcon?.classList.toggle('hidden', isOpen);
    btn.setAttribute('aria-expanded', String(!isOpen));
  });

  document.querySelectorAll('.mobile-group-btn').forEach(groupBtn => {
    groupBtn.addEventListener('click', () => {
      const target = groupBtn.getAttribute('data-target');
      const submenu = document.getElementById(target ?? '');
      submenu?.classList.toggle('hidden');
    });
  });

  // Close mobile menu on link click
  document.querySelectorAll('#mobile-menu a').forEach(link => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
      hamburger?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    });
  });
</script>
