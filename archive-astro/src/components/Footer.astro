          <li><a href="/similar-networks/" class="text-sm text-mesh-muted hover:text-mesh-green transition-colors">Similar Networks</a></li>
          <li><a href="/partners/" class="text-sm text-mesh-muted hover:text-mesh-green transition-colors">Partners</a></li>
          <li><a href="mailto:ntxmesh@gmail.com" class="text-sm text-mesh-muted hover:text-mesh-green transition-colors">Contact Us</a></li>
        </ul>
      </div>

    </div>

    <div class="mt-10 pt-8 border-t border-mesh-border flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-mesh-muted">
