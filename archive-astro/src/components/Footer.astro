      <!-- Learn -->
      <div>
        <h3 class="font-mono text-sm font-bold text-mesh-text uppercase tracking-wider mb-4">Learn</h3>
        <ul class="space-y-2">
          <li><a href="/learn/#about" class="text-sm text-mesh-muted hover:text-mesh-green transition-colors">About NTX Mesh</a></li>
          <li><a href="/learn/#coverage" class="text-sm text-mesh-muted hover:text-mesh-green transition-colors">Network Coverage</a></li>
          <li><a href="/coverage-map/" class="text-sm text-mesh-muted hover:text-mesh-green transition-colors">Modem Presets by County</a></li>
          <li><a href="/mc-repeaters/" class="text-sm text-mesh-muted hover:text-mesh-green transition-colors">MeshCore Repeaters</a></li>
          <li><a href="/learn/#comparisons" class="text-sm text-mesh-muted hover:text-mesh-green transition-colors">Compare to APRS</a></li>
        </ul>
      </div>

      <!-- Join & Devices -->
      <div>
        <h3 class="font-mono text-sm font-bold text-mesh-text uppercase tracking-wider mb-4">Join</h3>
        <ul class="space-y-2">
          <li><a href="/join/#network" class="text-sm text-mesh-muted hover:text-mesh-green transition-colors">Connect to the Network</a></li>
          <li><a href="/join/#best-practices" class="text-sm text-mesh-muted hover:text-mesh-green transition-colors">Best Practices</a></li>
          <li><a href="/devices/" class="text-sm text-mesh-muted hover:text-mesh-green transition-colors">Devices & Hardware</a></li>
          <li><a href="/devices/#solar" class="text-sm text-mesh-muted hover:text-mesh-green transition-colors">Build a Solar Repeater</a></li>
        </ul>
      </div>

      <!-- Community -->
      <div>
        <h3 class="font-mono text-sm font-bold text-mesh-text uppercase tracking-wider mb-4">Community</h3>
        <ul class="space-y-2">
